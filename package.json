{
  "name": "enginx-platform",
  "version": "1.0.0",
  "description": "EnginX: Multi-Discipline Engineering Learning Platform (CSE, ECE, AI, Cyber, Robotics, Hardware)",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix frontend run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000",
    "dev:evaluator": "cd evaluation && uvicorn evaluator:app --reload --port 8001",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend run test && npm --prefix frontend run build && python evaluation/test_evaluator.py",
    "test:evaluation": "cd evaluation && python test_evaluator.py"
  },
  "keywords": [
    "education",
    "leetcode",
    "verilog",
    "embedded-c",
    "cybersecurity",
    "robotics",
    "hardware",
    "ai-ml"
  ],
  "author": "EnginX Team",
  "license": "MIT"
}
