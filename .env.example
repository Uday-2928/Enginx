# ==========================================
# EnginX Platform Environment Configuration
# ==========================================

# Frontend (Vite)
# Leave empty for same-origin /api requests through the Vite proxy.
# Set an explicit public origin only for a separately hosted API with CORS.
VITE_API_URL=
# Server-side target for local dev/preview (Docker uses http://backend:8000).
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_EVALUATION_API=http://localhost:8001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend (FastAPI)
PORT=8000
EVALUATION_SERVICE_URL=http://localhost:8001/api/evaluate
DATABASE_URL=sqlite:///./enginx.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/enginx
JWT_SECRET=super-secret-jwt-key-change-in-production
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Evaluation Sandbox
EVALUATION_PORT=8001
MAX_TIMEOUT_SECONDS=10
MAX_MEMORY_MB=256

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_GAMIFICATION=true
