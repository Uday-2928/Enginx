


# ==========================================
# Cybersecurity Domain
# ==========================================
#
# The cybersecurity discipline is broken into focused knowledge tracks that map
# onto the existing Challenge.discipline values.  These tracks also gate the
# cyber-specific badge criteria and the skill-tree layout in the frontend.
CYBERSECURITY_DISCIPLINES = frozenset({
    "fundamentals",
    "networking",
    "linux",
    "web_security",
    "cryptography",
    "forensics",
    "penetration_testing",
    "blue_team",
})


def _validate_cyber_discipline(value: str) -> str:
    """Shared validator for the cybersecurity discipline enum.

    Raises:
        ValueError: if ``value`` is not a supported discipline.
    """
    if value not in CYBERSECURITY_DISCIPLINES:
        raise ValueError(
            f"discipline must be one of {sorted(CYBERSECURITY_DISCIPLINES)}, got {value!r}"
        )
    return value


# ---------------------------------------------------------------------------
# SQLAlchemy ORM models
# ---------------------------------------------------------------------------

class CyberChallenge(Base):
    """A cybersecurity challenge scoped to a specific discipline track.

    Mirrors the public ``Challenge`` table but captures cyber-only metadata
    (discipline, category, flags, scoring, hardening level) required by the CTF
    runner.  Each cyber challenge can own many ``CyberSubmission`` attempts and
    many ``CyberChallengeResource`` supporting materials.
    """

    __tablename__ = "cyber_challenges"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    slug = Column(String(120), unique=True, index=True, nullable=False)
    title = Column(String(255), nullable=False)
    discipline = Column(String(50), index=True, nullable=False)
    difficulty = Column(String(20), nullable=False)  # 'Easy', 'Medium', 'Hard'
    category = Column(String(100), index=True, nullable=False)
    description = Column(Text, nullable=False)
    encrypted_flag = Column(Text, nullable=False)
    decryption_steps = Column(JSON, nullable=False)  # ordered list of hint strings
    scoring_config = Column(JSON, default=dict)
    hardening_level = Column(Integer, default=1, nullable=False, index=True)
    tags = Column(JSON, default=list)
    xp_reward = Column(Integer, default=100, nullable=False)
    order_index = Column(Integer, default=0, index=True)
    active = Column(Boolean, default=True, nullable=False, index=True)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
    updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)

    submissions = relationship(
        "CyberSubmission",
        back_populates="challenge",
        cascade="all, delete-orphan",
        order_by="CyberSubmission.submitted_at",
    )
    resources = relationship(
        "CyberChallengeResource",
        back_populates="challenge",
        cascade="all, delete-orphan",
    )
    hints = relationship(
        "CyberChallengeHint",
        back_populates="challenge",
        cascade="all, delete-orphan",
        order_by="CyberChallengeHint.order_index",
    )
    progress = relationship(
        "CyberProgress",
        back_populates="challenge",
        cascade="all, delete-orphan",
    )
    flag_attempts = relationship(
        "CyberFlagAttempt",
        back_populates="challenge",
        cascade="all, delete-orphan",
    )
    badges = relationship(
        "CyberBadge",
        back_populates="challenge",
        cascade="all, delete-orphan",
    )


class CyberSubmission(Base):
    """A single flag-capture attempt against a cyber challenge."""

    __tablename__ = "cyber_submissions"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    user_id = Column(String(36), ForeignKey("users.id", ondelete="CASCADE"), nullable=False, index=True)
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
    attempted_flag = Column(Text, nullable=False)
    verdict = Column(String(20), nullable=False)  # 'AC', 'WA', 'CE', 'RE', 'TLE', 'UNAVAILABLE'
    execution_time_ms = Column(Float, default=0.0, nullable=False)
    memory_used_kb = Column(Float, default=0.0, nullable=False)
    output = Column(Text, nullable=True)
    submitted_at = Column(DateTime, default=datetime.utcnow, nullable=False, index=True)

    user = relationship("User")
    challenge = relationship("CyberChallenge", back_populates="submissions")
    flag_attempts = relationship(
        "CyberFlagAttempt",
        back_populates="submission",
        cascade="all, delete-orphan",
    )


class CyberChallengeResource(Base):
    """Supporting artefacts (network traces, disk images, source) for a challenge."""

    __tablename__ = "cyber_challenge_resources"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
    resource_type = Column(String(50), nullable=False, index=True)  # 'pcap', 'image', 'script', 'document'
    name = Column(String(255), nullable=False)
    description = Column(Text, nullable=False, default="")
    content = Column(Text, nullable=True)  # inline content when not using storage_url
    storage_url = Column(String(500), nullable=True, index=True)  # reference to object storage
    file_size_bytes = Column(Integer, nullable=True)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)

    challenge = relationship("CyberChallenge", back_populates="resources")


class CyberChallengeHint(Base):
    """Progressive hints revealed as a learner spends time or burns attempts."""

    __tablename__ = "cyber_challenge_hints"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
    order_index = Column(Integer, nullable=False, index=True)
    body = Column(Text, nullable=False)
    cost_xp = Column(Integer, default=0, nullable=False)  # XP deducted to reveal this hint
    penalty_seconds = Column(Integer, default=0, nullable=False)  # time penalty to reveal

    challenge = relationship("CyberChallenge", back_populates="hints")


class CyberFlagAttempt(Base):
    """A captured flag verification attempt tied to a submission."""

    __tablename__ = "cyber_flag_attempts"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    submission_id = Column(
        String(36),
        ForeignKey("cyber_submissions.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
    flag_hash = Column(String(255), nullable=False, index=True)
    is_correct = Column(Boolean, default=False, nullable=False, index=True)
    attempted_at = Column(DateTime, default=datetime.utcnow, nullable=False, index=True)

    submission = relationship("CyberSubmission", back_populates="flag_attempts")
    challenge = relationship("CyberChallenge", back_populates="flag_attempts")


class CyberProgress(Base):
    """Per-user completion tracking for a cyber challenge."""

    __table_args__ = (
        UniqueConstraint("user_id", "challenge_id", name="uq_cyber_progress_user_challenge"),
    )

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    user_id = Column(String(36), ForeignKey("users.id", ondelete="CASCADE"), nullable=False, index=True)
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=False,
        index=True,
    )
    completed = Column(Boolean, default=False, nullable=False, index=True)
    attempts_count = Column(Integer, default=0, nullable=False)
    best_execution_time_ms = Column(Float, nullable=True)
    xp_awarded = Column(Integer, default=0, nullable=False)
    first_completed_at = Column(DateTime, nullable=True)
    updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)

    challenge = relationship("CyberChallenge", back_populates="progress")
    user = relationship("User", back_populates="cyber_progress")


class CyberBadge(Base):
    """A cyber-specific badge tied to a single challenge (or the whole discipline)."""

    __tablename__ = "cyber_badges"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    user_id = Column(String(36), ForeignKey("users.id", ondelete="CASCADE"), nullable=False, index=True)
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=True,
        index=True,
    )
    badge_type = Column(String(50), nullable=False, index=True)  # 'first_blood', 'perfect', 'fastest', 'discipline'
    name = Column(String(255), nullable=False)
    description = Column(Text, nullable=False)
    icon = Column(String(100), nullable=False)
    xp_bonus = Column(Integer, default=100, nullable=False)
    awarded_at = Column(DateTime, default=datetime.utcnow, nullable=False)

    challenge = relationship("CyberChallenge", back_populates="badges")
    user = relationship("User", back_populates="cyber_badges")


# Back-populates wiring for the User model relationships declared above.
User.cyber_progress = relationship(
    "CyberProgress",
    back_populates="user",
    cascade="all, delete-orphan",
    order_by=CyberProgress.first_completed_at.desc(),
)
User.cyber_badges = relationship(
    "CyberBadge",
    back_populates="user",
    cascade="all, delete-orphan",
    order_by=CyberBadge.awarded_at.desc(),
)


class CyberChallengeCompletionRank(Base):
    """Materialized leaderboard row: first-to-blood and fastest solve times."""

    __tablename__ = "cyber_challenge_completion_ranks"

    id = Column(String(36), primary_key=True, default=lambda: str(uuid.uuid4()))
    challenge_id = Column(
        String(36),
        ForeignKey("cyber_challenges.id", ondelete="CASCADE"),
        nullable=False,
        unique=True,
    )
    first_completer_user_id = Column(String(36), ForeignKey("users.id"), nullable=True)
    fastest_user_id = Column(String(36), ForeignKey("users.id"), nullable=True)
    fastest_solve_seconds = Column(Float, nullable=True)
    completion_count = Column(Integer, default=0, nullable=False)
    last_updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)

    challenge = relationship("CyberChallenge", back_populates="completion_rank")


CyberChallenge.completion_rank = relationship(
    "CyberChallengeCompletionRank",
    back_populates="challenge",
    uselist=False,
    cascade="all, delete-orphan",
)


# ---------------------------------------------------------------------------
# Pydantic schemas (API validation)
# ---------------------------------------------------------------------------

class CyberChallengeBase(BaseModel):
    slug: str = Field(..., min_length=1, max_length=120)
    title: str = Field(..., min_length=1, max_length=255)
    discipline: str
    difficulty: Literal["Easy", "Medium", "Hard"]
    category: str = Field(..., min_length=1, max_length=100)
    description: str = Field(..., min_length=1)
    encrypted_flag: str = Field(..., min_length=1)
    decryption_steps: List[str] = Field(default_factory=list)
    scoring_config: Dict[str, Any] = Field(default_factory=dict)
    hardening_level: int = Field(default=1, ge=1, le=5)
    tags: List[str] = Field(default_factory=list)
    xp_reward: int = Field(default=100, ge=0, le=100000)
    order_index: int = Field(default=0, ge=0)
    active: bool = True

    @field_validator("discipline")
    @classmethod
    def discipline_is_valid(cls, value: str) -> str:
        return _validate_cyber_discipline(value)


class CyberChallengeCreate(CyberChallengeBase):
    resources: List["CyberChallengeResourceCreate"] = Field(default_factory=list)
    hints: List["CyberChallengeHintCreate"] = Field(default_factory=list)


class CyberChallengeUpdate(BaseModel):
    model_config = ConfigDict(extra="forbid")

    slug: Optional[str] = Field(default=None, min_length=1, max_length=120)
    title: Optional[str] = Field(default=None, min_length=1, max_length=255)
    discipline: Optional[str] = None
    difficulty: Optional[Literal["Easy", "Medium", "Hard"]] = None
    category: Optional[str] = Field(default=None, min_length=1, max_length=100)
    description: Optional[str] = Field(default=None, min_length=1)
    encrypted_flag: Optional[str] = Field(default=None, min_length=1)
    decryption_steps: Optional[List[str]] = None
    scoring_config: Optional[Dict[str, Any]] = None
    hardening_level: Optional[int] = Field(default=None, ge=1, le=5)
    tags: Optional[List[str]] = None
    xp_reward: Optional[int] = Field(default=None, ge=0, le=100000)
    order_index: Optional[int] = Field(default=None, ge=0)
    active: Optional[bool] = None

    @field_validator("discipline")
    @classmethod
    def discipline_is_valid(cls, value: Optional[str]) -> Optional[str]:
        if value is not None:
            return _validate_cyber_discipline(value)
        return value


class CyberChallengeSummary(BaseModel):
    id: str
    slug: str
    title: str
    discipline: str
    difficulty: str
    category: str
    hardening_level: int
    xp_reward: int
    order_index: int
    active: bool

    class Config:
        from_attributes = True


class CyberChallengeDetail(CyberChallengeSummary):
    description: str
    encrypted_flag: str
    decryption_steps: List[str]
    scoring_config: Dict[str, Any]
    tags: List[str]
    created_at: datetime
    updated_at: datetime
    resources: List["CyberChallengeResourceSummary"]
    hints: List["CyberChallengeHintSummary"]


class CyberChallengeResourceBase(BaseModel):
    resource_type: Literal["pcap", "image", "script", "document"]
    name: str = Field(..., min_length=1, max_length=255)
    description: str = Field(default="", max_length=2000)
    content: Optional[str] = Field(default=None, max_length=1024 * 1024)
    storage_url: Optional[str] = Field(default=None, max_length=500)
    file_size_bytes: Optional[int] = Field(default=None, ge=0, le=1024 * 1024 * 1024)


class CyberChallengeResourceCreate(CyberChallengeResourceBase):
    pass


class CyberChallengeResourceSummary(BaseModel):
    id: str
    resource_type: str
    name: str
    description: str
    storage_url: Optional[str]
    file_size_bytes: Optional[int]
    created_at: datetime

    class Config:
        from_attributes = True


class CyberChallengeHintBase(BaseModel):
    order_index: int = Field(..., ge=0)
    body: str = Field(..., min_length=1)
    cost_xp: int = Field(default=0, ge=0)
    penalty_seconds: int = Field(default=0, ge=0)


class CyberChallengeHintCreate(CyberChallengeHintBase):
    pass


class CyberChallengeHintSummary(BaseModel):
    id: str
    order_index: int
    body: str
    cost_xp: int
    penalty_seconds: int

    class Config:
        from_attributes = True


class CyberSubmissionCreate(BaseModel):
    challenge_id: str
    attempted_flag: str = Field(..., min_length=1, max_length=2048)


class CyberFlagAttemptCreate(BaseModel):
    challenge_id: str
    submission_id: Optional[str] = None
    flag_hash: str
    is_correct: bool = False


class CyberSubmissionResponse(BaseModel):
    id: str
    challenge_id: str
    attempted_flag: str
    verdict: str
    execution_time_ms: float
    memory_used_kb: float
    output: Optional[str]
    submitted_at: datetime
    xp_awarded: int = 0
    new_badges: List[str] = []
    status: str = "evaluated"
    retryable: bool = False

    class Config:
        from_attributes = True


class CyberFlagAttemptResponse(BaseModel):
    id: str
    submission_id: str
    challenge_id: str
    flag_hash: str
    is_correct: bool
    attempted_at: datetime

    class Config:
        from_attributes = True


class CyberProgressResponse(BaseModel):
    id: str
    user_id: str
    challenge_id: str
    completed: bool
    attempts_count: int
    best_execution_time_ms: Optional[float]
    xp_awarded: int
    first_completed_at: Optional[datetime]
    updated_at: datetime

    class Config:
        from_attributes = True


class CyberBadgeSummary(BaseModel):
    id: str
    badge_type: str
    name: str
    description: str
    icon: str
    xp_bonus: int
    awarded_at: datetime
    challenge_id: Optional[str]

    class Config:
        from_attributes = True
